      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "the REJECT comes back as ICMP port unreachable and the lookup fails in milliseconds",
      "run": [
        "sh",
        "-c",
        "s=$(date +%s%N); getent hosts web; r=$?; e=$(( ($(date +%s%N) - s) / 1000000 )); echo \"exit $r after $e ms\""
      ],
      "save": "dns-noendpoints.txt",
      "expect_contains": [
