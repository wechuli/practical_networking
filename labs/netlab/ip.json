{
  "name": "ip",
  "description": "IPv4 on the wire: TTL, header fields, fragmentation and DF, missing routes, and on-link routes",
  "nodes": [
    { "name": "client", "routes": [ { "dst": "198.19.5.0/24", "via": "198.18.5.254" } ] },
    { "name": "router", "sysctls": { "net.ipv4.ip_forward": "1" } },
    { "name": "server", "routes": [ { "dst": "198.18.5.0/24", "via": "198.19.5.254" } ] },
    { "name": "a" },
    { "name": "b" }
  ],
  "links": [
    { "a": { "node": "client", "if": "eth0", "addr": ["198.18.5.1/24"] },
      "b": { "node": "router", "if": "eth0", "addr": ["198.18.5.254/24"] } },
    { "a": { "node": "router", "if": "eth1", "addr": ["198.19.5.254/24"], "mtu": 1400 },
      "b": { "node": "server", "if": "eth0", "addr": ["198.19.5.2/24"], "mtu": 1400 } },
    { "a": { "node": "a", "if": "eth0", "addr": ["198.51.100.10/25"] },
      "b": { "node": "b", "if": "eth0", "addr": ["198.51.100.200/25"] } }
  ],
  "checks": [
    { "type": "command", "node": "client", "save": "route-get.txt",
      "name": "the kernel's routing decision for the server: next hop, interface, source address",
      "run": ["ip", "route", "get", "198.19.5.2"],
      "expect_contains": ["198.19.5.2 via 198.18.5.254 dev eth0 src 198.18.5.1"] },
    { "type": "ping", "from": "client", "to": "198.19.5.2", "expect": "reachable",
      "name": "the client reaches the server through the router" },
    { "type": "capture", "node": "server", "if": "eth0", "filter": "icmp", "save": "header.pcap",
      "decode": ["-nn", "-v"],
      "name": "IPv4 header fields: the request arrives with TTL 63 (one router), the reply leaves with TTL 64",
      "during": { "node": "client", "run": ["ping", "-c", "1", "198.19.5.2"] },
      "expect_contains": ["ttl 63", "ttl 64", "flags [DF]", "proto ICMP (1), length 84", "198.18.5.1 > 198.19.5.2: ICMP echo request"] },
    { "type": "capture", "node": "client", "if": "eth0", "filter": "icmp", "save": "ttl-exceeded.pcap",
      "decode": ["-nn", "-v"],
      "name": "TTL 1: the router decrements it to 0, drops the packet, and says so (this is how traceroute works)",
      "during": { "node": "client", "run": ["ping", "-c", "1", "-t", "1", "198.19.5.2"] },
      "expect_contains": ["ttl 1,", "198.18.5.254 > 198.18.5.1: ICMP time exceeded in-transit"] },
    { "type": "capture", "node": "client", "if": "eth0", "filter": "icmp", "save": "frag-needed.pcap",
      "decode": ["-nn", "-v"],
      "name": "DF set and too big for the 1400-byte link: the router drops it and reports the MTU",
      "during": { "node": "client", "run": ["ping", "-c", "1", "-M", "do", "-s", "1400", "198.19.5.2"] },
      "expect_contains": ["length 1428", "198.18.5.254 > 198.18.5.1: ICMP 198.19.5.2 unreachable - need to frag (mtu 1400)"] },
    { "type": "command", "node": "client", "save": "pmtu-cache.txt",
      "name": "the client cached the smaller path MTU for that destination",
      "run": ["ip", "route", "get", "198.19.5.2"], "expect_contains": ["mtu 1400"] },
    { "type": "command", "node": "client", "save": "df-local.txt",
      "name": "the next DF ping fails locally: the kernel already knows the path MTU",
      "run": ["ping", "-c", "1", "-M", "do", "-s", "1400", "198.19.5.2"],
      "expect_exit": 1, "expect_contains": ["message too long, mtu=1400"] },
    { "type": "capture", "node": "server", "if": "eth0", "filter": "icmp", "save": "fragments.pcap",
      "decode": ["-nn", "-v"],
      "name": "DF clear: the packet is fragmented, the first piece has More Fragments set",
      "during": { "node": "client", "run": ["ping", "-c", "1", "-M", "dont", "-s", "2000", "198.19.5.2"] },
      "expect_contains": ["offset 0, flags [+]", "offset 1376"] },
    { "type": "command", "node": "client", "save": "no-route.txt",
      "name": "no route at all: the error is immediate and local, no packet is sent",
      "run": ["ping", "-c", "1", "203.0.113.10"],
      "expect_exit": 2, "expect_contains": ["Network is unreachable"] },
    { "type": "command", "node": "a", "save": "other-subnet.txt",
      "name": "same cable, different subnets: no route to 198.51.100.200 from a /25 that ends at .127",
      "run": ["ping", "-c", "1", "198.51.100.200"],
      "expect_exit": 2, "expect_contains": ["Network is unreachable"] },
    { "type": "command", "node": "a", "name": "add an on-link route on a",
      "run": ["ip", "route", "add", "198.51.100.128/25", "dev", "eth0"] },
    { "type": "command", "node": "b", "name": "and the return route on b",
      "run": ["ip", "route", "add", "198.51.100.0/25", "dev", "eth0"] },
    { "type": "ping", "from": "a", "to": "198.51.100.200", "expect": "reachable",
      "name": "now a ARPs for b directly and the ping works" },
    { "type": "command", "node": "a", "save": "a-routes.txt", "name": "a's routing table",
      "run": ["ip", "route"],
      "expect_contains": ["198.51.100.0/25 dev eth0 proto kernel scope link src 198.51.100.10", "198.51.100.128/25 dev eth0 scope link"] }
  ]
}
