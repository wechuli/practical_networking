{
  "name": "ipv6",
  "description": "IPv6 without configuration: router advertisements, SLAAC, Neighbor Discovery, duplicate address detection, and Packet Too Big",
  "nodes": [
    { "name": "client",
      "sysctls": { "net.ipv6.conf.default.accept_ra": "2", "net.ipv6.conf.default.autoconf": "1" } },
    { "name": "router",
      "sysctls": { "net.ipv6.conf.all.forwarding": "1" },
      "services": [
        { "name": "radvd",
          "run": ["dnsmasq", "--keep-in-foreground", "--conf-file=/dev/null", "--port=0", "--user=root",
                  "--interface=eth0", "--bind-interfaces", "--enable-ra",
                  "--dhcp-range=::,constructor:eth0,ra-only,64,2m", "--ra-param=eth0,10,60",
                  "--pid-file=/tmp/netlab-ipv6-ra.pid", "--log-facility=-"] }
      ] },
    { "name": "server", "routes": [ { "dst": "fd42:1::/64", "via": "fd42:2::1" } ] }
  ],
  "links": [
    { "a": { "node": "client", "if": "eth0" },
      "b": { "node": "router", "if": "eth0", "addr": ["fd42:1::1/64"] } },
    { "a": { "node": "router", "if": "eth1", "addr": ["fd42:2::1/64"], "mtu": 1280 },
      "b": { "node": "server", "if": "eth0", "addr": ["fd42:2::2/64"], "mtu": 1280 } }
  ],
  "checks": [
    { "type": "capture", "node": "client", "if": "eth0", "filter": "icmp6", "save": "ra.pcap",
      "decode": ["-nn", "-v"],
      "name": "the client asks for a router (RS to ff02::2) and the router advertises the prefix (RA)",
      "during": { "node": "client",
                  "run": ["sh", "-c", "ip link set eth0 down; ip link set eth0 up; for i in $(seq 100); do ip -6 route show default | grep -q 'proto ra' && exit 0; sleep 0.2; done; exit 1"] },
      "expect_contains": ["> ff02::2:", "router solicitation", "ICMP6, router advertisement", "router lifetime 60s", "fd42:1::/64"] },
    { "type": "command", "node": "client", "save": "default-route.txt",
      "name": "the default route was learned from the RA and points at the router's link-local address",
      "run": ["ip", "-6", "route", "show", "default"],
      "expect_contains": ["default via fe80::", "dev eth0 proto ra"] },
    { "type": "command", "node": "client", "save": "addresses.txt", "timeout": "10s",
      "name": "SLAAC built a global address from the advertised prefix; the link-local address came first",
      "run": ["ip", "-6", "address", "show", "dev", "eth0"],
      "expect_contains": ["inet6 fd42:1::", "scope global dynamic", "inet6 fe80::", "scope link"],
      "expect_absent": ["tentative"] },
    { "type": "command", "node": "client", "save": "ping.txt", "timeout": "10s",
      "name": "the client reaches the server across the router with no address configured by hand",
      "run": ["ping", "-6", "-c", "2", "-W", "1", "fd42:2::2"],
      "expect_exit": 0, "expect_contains": ["2 received"] },
    { "type": "command", "node": "client", "save": "neighbors.txt",
      "name": "Neighbor Discovery replaced ARP: the router is in the neighbor table, flagged as a router",
      "run": ["ip", "-6", "neigh", "show", "dev", "eth0"],
      "expect_contains": ["fe80::", "lladdr", "router"] },
    { "type": "capture", "node": "client", "if": "eth0", "filter": "icmp6", "save": "ptb.pcap",
      "decode": ["-nn", "-v"],
      "name": "routers never fragment IPv6: a 1448-byte packet for a 1280-byte link gets Packet Too Big",
      "during": { "node": "client", "run": ["ping", "-6", "-c", "1", "-W", "1", "-M", "do", "-s", "1400", "fd42:2::2"] },
      "expect_contains": ["ICMP6, packet too big, mtu 1280"] },
    { "type": "command", "node": "client", "save": "ptb-ping.txt",
      "name": "the sender now knows the path MTU and refuses the next one locally",
      "run": ["ping", "-6", "-c", "1", "-W", "1", "-M", "do", "-s", "1400", "fd42:2::2"],
      "expect_exit": 1, "expect_contains": ["mtu"] },
    { "type": "command", "node": "router", "name": "the router takes fd42:1::99 without checking (nodad)",
      "run": ["ip", "-6", "address", "add", "fd42:1::99/64", "dev", "eth0", "nodad"] },
    { "type": "capture", "node": "client", "if": "eth0", "filter": "icmp6", "save": "dad.pcap",
      "decode": ["-nn", "-v"],
      "name": "DAD: the client asks from :: whether anyone has fd42:1::99; the router answers",
      "during": { "node": "client", "run": ["sh", "-c", "ip -6 address add fd42:1::99/64 dev eth0 && sleep 3"] },
      "expect_contains": [":: > ff02::1:ff00:99", "neighbor solicitation, who has fd42:1::99", "neighbor advertisement, tgt is fd42:1::99"] },
    { "type": "command", "node": "client", "save": "dad.txt", "timeout": "8s",
      "name": "the client marks its copy dadfailed and never uses it",
      "run": ["ip", "-6", "address", "show", "to", "fd42:1::99"],
      "expect_contains": ["dadfailed"] }
  ]
}
