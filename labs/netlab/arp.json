{
  "name": "arp",
  "description": "ARP on one switched segment: resolution, cache states, failure, VIP failover with and without gratuitous ARP, conflicts, static entries, and proxy ARP",
  "nodes": [
    { "name": "switch", "bridges": [ { "name": "br0" } ] },
    { "name": "client",
      "setup": [["ip", "link", "set", "eth0", "address", "02:00:00:00:06:01"],
                ["sysctl", "-qw", "net.ipv4.neigh.eth0.base_reachable_time_ms=12000"]] },
    { "name": "web1",
      "setup": [["ip", "link", "set", "eth0", "address", "02:00:00:00:06:0a"],
                ["ip", "address", "add", "198.18.6.100/24", "dev", "eth0"]] },
    { "name": "web2", "setup": [["ip", "link", "set", "eth0", "address", "02:00:00:00:06:0b"]] },
    { "name": "intruder", "setup": [["ip", "link", "set", "eth0", "address", "02:00:00:00:06:66"]] },
    { "name": "node",
      "sysctls": { "net.ipv4.ip_forward": "1" },
      "setup": [["ip", "link", "set", "cali1", "address", "02:00:00:00:07:fe"],
                ["ip", "route", "add", "default", "via", "198.18.6.1", "dev", "eth0"],
                ["ip", "route", "add", "198.18.7.5/32", "dev", "cali1"],
                ["sysctl", "-qw", "net.ipv4.conf.cali1.proxy_arp=1"]] },
    { "name": "pod",
      "setup": [["ip", "link", "set", "eth0", "address", "02:00:00:00:07:05"],
                ["ip", "route", "add", "169.254.1.1", "dev", "eth0", "scope", "link"],
                ["ip", "route", "add", "default", "via", "169.254.1.1", "dev", "eth0"]] }
  ],
  "links": [
    { "a": { "node": "client", "if": "eth0", "addr": ["198.18.6.1/24"] }, "b": { "node": "switch", "if": "p1", "bridge": "br0" } },
    { "a": { "node": "web1", "if": "eth0", "addr": ["198.18.6.10/24"] }, "b": { "node": "switch", "if": "p2", "bridge": "br0" } },
    { "a": { "node": "web2", "if": "eth0", "addr": ["198.18.6.11/24"] }, "b": { "node": "switch", "if": "p3", "bridge": "br0" } },
    { "a": { "node": "intruder", "if": "eth0", "addr": ["198.18.6.66/24"] }, "b": { "node": "switch", "if": "p4", "bridge": "br0" } },
    { "a": { "node": "node", "if": "eth0", "addr": ["198.18.6.20/24"] }, "b": { "node": "switch", "if": "p5", "bridge": "br0" } },
    { "a": { "node": "pod", "if": "eth0", "addr": ["198.18.7.5/32"] }, "b": { "node": "node", "if": "cali1" } }
  ],
  "checks": [
    { "type": "capture", "node": "client", "if": "eth0", "filter": "arp", "decode": ["-e", "-nn"], "save": "resolve.pcap",
      "name": "first contact: a broadcast request, a unicast reply",
      "during": { "node": "client", "run": ["ping", "-c", "1", "198.18.6.10"] },
      "expect_contains": [
        "02:00:00:00:06:01 > ff:ff:ff:ff:ff:ff, ethertype ARP (0x0806), length 42: Request who-has 198.18.6.10 tell 198.18.6.1, length 28",
        "02:00:00:00:06:0a > 02:00:00:00:06:01, ethertype ARP (0x0806), length 42: Reply 198.18.6.10 is-at 02:00:00:00:06:0a, length 28"] },
    { "type": "command", "node": "client", "save": "client-neigh.txt", "name": "the client cached the answer as REACHABLE",
      "run": ["ip", "neigh", "show", "198.18.6.10"],
      "expect_contains": ["198.18.6.10 dev eth0 lladdr 02:00:00:00:06:0a REACHABLE"] },
    { "type": "command", "node": "web1", "save": "web1-neigh.txt",
      "name": "web1 learned the client from the request itself; it never had to ask",
      "run": ["ip", "neigh", "show", "198.18.6.1"],
      "expect_contains": ["198.18.6.1 dev eth0 lladdr 02:00:00:00:06:01"] },
    { "type": "command", "node": "client", "save": "stale.txt", "timeout": "25s",
      "name": "a few seconds without confirmation: REACHABLE becomes STALE (base_reachable_time_ms is 12000 here, 30000 by default)",
      "run": ["ip", "neigh", "show", "198.18.6.10"], "expect_contains": ["lladdr 02:00:00:00:06:0a STALE"] },
    { "type": "capture", "node": "client", "if": "eth0", "filter": "arp", "decode": ["-e", "-nn"], "save": "probe.pcap",
      "name": "using a STALE entry: send at once (DELAY), then confirm with a UNICAST request 5 s later (PROBE)",
      "during": { "node": "client", "run": ["sh", "-c", "ping -c 1 198.18.6.10; ip neigh show 198.18.6.10; sleep 6.5; ip neigh show 198.18.6.10"] },
      "expect_contains": ["DELAY",
        "02:00:00:00:06:01 > 02:00:00:00:06:0a, ethertype ARP (0x0806), length 42: Request who-has 198.18.6.10 tell 198.18.6.1",
        "02:00:00:00:06:0a > 02:00:00:00:06:01, ethertype ARP (0x0806), length 42: Reply 198.18.6.10 is-at 02:00:00:00:06:0a"],
      "expect_absent": ["> ff:ff:ff:ff:ff:ff"] },
    { "type": "capture", "node": "client", "if": "eth0", "filter": "arp", "decode": ["-e", "-nn"], "save": "failed.pcap",
      "name": "nobody owns 198.18.6.99: three broadcasts one second apart, then ping reports the failure",
      "during": { "node": "client", "run": ["ping", "-c", "1", "-W", "5", "198.18.6.99"] },
      "expect_contains": ["Request who-has 198.18.6.99 tell 198.18.6.1", "From 198.18.6.1 icmp_seq=1 Destination Host Unreachable"],
      "expect_absent": ["is-at"] },
    { "type": "command", "node": "client", "save": "failed.txt", "name": "the cache remembers the failure",
      "run": ["ip", "neigh", "show", "198.18.6.99"], "expect_contains": ["198.18.6.99 dev eth0 FAILED"] },

    { "type": "ping", "from": "client", "to": "198.18.6.100", "expect": "reachable",
      "name": "the virtual IP 198.18.6.100 lives on web1" },
    { "type": "command", "node": "web1", "name": "failover, part 1: web1 gives up the VIP",
      "run": ["ip", "address", "del", "198.18.6.100/24", "dev", "eth0"] },
    { "type": "capture", "node": "client", "if": "eth0", "filter": "arp", "decode": ["-e", "-nn"], "save": "silent-takeover.pcap",
      "name": "failover, part 2: web2 takes the VIP; Linux announces nothing when an address is added",
      "during": { "node": "web2", "run": ["sh", "-c", "ip address add 198.18.6.100/24 dev eth0; sleep 1"] },
      "expect_absent": ["198.18.6.100"] },
    { "type": "command", "node": "client", "save": "old-mac.txt",
      "name": "the client still sends to web1's MAC, which drops the packets",
      "run": ["sh", "-c", "ping -c 1 -W 1 198.18.6.100; r=$?; ip neigh show 198.18.6.100; exit $r"],
      "expect_exit": 1, "expect_contains": ["198.18.6.100 dev eth0 lladdr 02:00:00:00:06:0a"] },
    { "type": "capture", "node": "client", "if": "eth0", "filter": "arp", "decode": ["-e", "-nn"], "save": "no-garp-recovery.pcap",
      "name": "recovery without gratuitous ARP: the entry must age, be probed (unicast, to the old MAC), fail, and be re-resolved",
      "during": { "node": "client", "run": ["timeout", "60", "sh", "-c",
        "s=$(date +%s%N); until ping -c 1 -W 0.2 198.18.6.100 >/dev/null; do sleep 0.1; done; echo \"recovered after $(( ($(date +%s%N) - s) / 1000000 )) ms\""] },
      "expect_contains": [
        "02:00:00:00:06:01 > 02:00:00:00:06:0a, ethertype ARP (0x0806), length 42: Request who-has 198.18.6.100 tell 198.18.6.1",
        "02:00:00:00:06:01 > ff:ff:ff:ff:ff:ff, ethertype ARP (0x0806), length 42: Request who-has 198.18.6.100 tell 198.18.6.1",
        "Reply 198.18.6.100 is-at 02:00:00:00:06:0b", "recovered after"] },
    { "type": "command", "node": "web2", "name": "failing back, part 1: web2 gives up the VIP",
      "run": ["ip", "address", "del", "198.18.6.100/24", "dev", "eth0"] },
    { "type": "command", "node": "web1", "name": "failing back, part 2: web1 takes it",
      "run": ["ip", "address", "add", "198.18.6.100/24", "dev", "eth0"] },
    { "type": "capture", "node": "client", "if": "eth0", "filter": "arp", "decode": ["-e", "-nn"], "save": "garp.pcap",
      "name": "this time web1 announces itself with a gratuitous ARP: sender IP = target IP, broadcast",
      "during": { "node": "web1", "run": ["arping", "-U", "-c", "1", "-I", "eth0", "198.18.6.100"] },
      "expect_contains": ["02:00:00:00:06:0a > ff:ff:ff:ff:ff:ff, ethertype ARP (0x0806), length 42: Request who-has 198.18.6.100 (ff:ff:ff:ff:ff:ff) tell 198.18.6.100"] },
    { "type": "command", "node": "client", "save": "after-garp.txt",
      "name": "the client's existing entry was overwritten at once; the first ping works",
      "run": ["sh", "-c", "ip neigh show 198.18.6.100; ping -c 1 -W 1 198.18.6.100"],
      "expect_exit": 0, "expect_contains": ["198.18.6.100 dev eth0 lladdr 02:00:00:00:06:0a STALE", "1 received"] },

    { "type": "command", "node": "intruder", "name": "the intruder takes an address the client has never used",
      "run": ["ip", "address", "add", "198.18.6.77/24", "dev", "eth0"] },
    { "type": "command", "node": "intruder", "name": "and announces it",
      "run": ["arping", "-U", "-c", "1", "-I", "eth0", "198.18.6.77"] },
    { "type": "command", "node": "client", "save": "arp-accept.txt",
      "name": "Linux does not create entries from announcements (arp_accept=0): nothing cached for 198.18.6.77",
      "run": ["ip", "neigh", "show", "198.18.6.77"], "expect_absent": ["lladdr"] },
    { "type": "ping", "from": "client", "to": "198.18.6.11", "expect": "reachable",
      "name": "the client talks to web2 at 198.18.6.11" },
    { "type": "command", "node": "intruder", "name": "the intruder also configures 198.18.6.11: an IP conflict",
      "run": ["ip", "address", "add", "198.18.6.11/24", "dev", "eth0"] },
    { "type": "command", "node": "client", "save": "conflict.txt",
      "name": "one ARP request, two different answers",
      "run": ["arping", "-c", "2", "-w", "3", "-I", "eth0", "198.18.6.11"], "allow_fail": true,
      "expect_contains": ["Unicast reply from 198.18.6.11 [02:00:00:00:06:0B]", "Unicast reply from 198.18.6.11 [02:00:00:00:06:66]", "Received 2 response(s)"] },
    { "type": "command", "node": "client", "save": "dad.txt",
      "name": "duplicate address detection (probe from 0.0.0.0) finds 198.18.6.11 taken: exit 1",
      "run": ["arping", "-D", "-c", "2", "-w", "3", "-I", "eth0", "198.18.6.11"], "expect_exit": 1 },
    { "type": "command", "node": "client", "save": "dad-free.txt",
      "name": "and 198.18.6.50 apparently free: exit 0 (silence now, not a guarantee later)",
      "run": ["arping", "-D", "-c", "2", "-w", "3", "-I", "eth0", "198.18.6.50"], "expect_exit": 0 },
    { "type": "command", "node": "intruder", "name": "the intruder announces 198.18.6.11 as its own",
      "run": ["arping", "-U", "-c", "1", "-I", "eth0", "198.18.6.11"] },
    { "type": "command", "node": "client", "save": "poisoned.txt",
      "name": "the client's entry for web2 now points at the intruder: unauthenticated, last writer wins",
      "run": ["ip", "neigh", "show", "198.18.6.11"], "expect_contains": ["lladdr 02:00:00:00:06:66"] },
    { "type": "command", "node": "client", "name": "pin web2's MAC with a static entry",
      "run": ["ip", "neigh", "replace", "198.18.6.11", "lladdr", "02:00:00:00:06:0b", "dev", "eth0", "nud", "permanent"] },
    { "type": "command", "node": "intruder", "name": "the intruder announces again",
      "run": ["arping", "-U", "-c", "1", "-I", "eth0", "198.18.6.11"] },
    { "type": "command", "node": "client", "save": "permanent.txt", "name": "the PERMANENT entry ignores it",
      "run": ["ip", "neigh", "show", "198.18.6.11"], "expect_contains": ["lladdr 02:00:00:00:06:0b PERMANENT"] },

    { "type": "capture", "node": "pod", "if": "eth0", "filter": "arp", "decode": ["-e", "-nn"], "save": "proxy-arp.pcap",
      "name": "a Calico-style pod: its gateway 169.254.1.1 exists nowhere; the node answers by proxy ARP",
      "during": { "node": "pod", "run": ["ping", "-c", "1", "-W", "2", "198.18.6.20"] },
      "expect_contains": ["02:00:00:00:07:05 > ff:ff:ff:ff:ff:ff, ethertype ARP (0x0806), length 42: Request who-has 169.254.1.1 tell 198.18.7.5", "02:00:00:00:07:fe > 02:00:00:00:07:05, ethertype ARP (0x0806), length 42: Reply 169.254.1.1 is-at 02:00:00:00:07:fe", "1 received"] },
    { "type": "command", "node": "pod", "save": "pod-neigh.txt", "name": "the pod's 'gateway' MAC is the node's cali1 interface",
      "run": ["sh", "-c", "ip neigh show 169.254.1.1; ip route"],
      "expect_contains": ["169.254.1.1 dev eth0 lladdr 02:00:00:00:07:fe", "default via 169.254.1.1 dev eth0"] },
    { "type": "command", "node": "node", "name": "turn proxy ARP off on cali1",
      "run": ["sysctl", "-w", "net.ipv4.conf.cali1.proxy_arp=0"] },
    { "type": "command", "node": "pod", "save": "no-proxy-arp.txt",
      "name": "without it, the pod cannot resolve its gateway and every packet fails",
      "run": ["sh", "-c", "ip neigh flush dev eth0; ping -c 1 -W 4 198.18.6.20"],
      "expect_exit": 1, "expect_contains": ["Destination Host Unreachable"] }
  ]
}
