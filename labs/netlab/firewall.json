{
  "name": "firewall",
  "description": "Firewalls measured: what ACCEPT, DROP and each REJECT type look like to a client (refused, no route to host, timeout), first-match order, counters, iptables as nftables, LOG from a namespace, stateful vs stateless (an AWS-NACL-style rule set, its missing return rule, and the hole a stateless return rule opens), tier segmentation, a SYN flood with and without SYN cookies, connection rate limiting, and identity-based authorization with mTLS (allowed, forbidden, no certificate, wrong CA, any location)",
  "nodes": [
    {
      "name": "client",
      "routes": [
        {
          "dst": "default",
          "via": "198.18.180.1"
        }
      ],
      "files": {
        "/etc/hosts": "127.0.0.1\tlocalhost\n198.18.181.10\tshop.test\n"
      },
      "services": [
        {
          "name": "tcp5000",
          "run": [
            "${BIN}/tcplab",
            "serve",
            "-addr",
            "198.18.180.10:5000",
            "-mode",
            "discard"
          ],
          "port": 5000
        }
      ]
    },
    {
      "name": "fw",
      "sysctls": {
        "net.ipv4.ip_forward": "1"
      }
    },
    {
      "name": "server",
      "routes": [
        {
          "dst": "default",
          "via": "198.18.181.1"
        }
      ],
      "setup": [
        [
          "sh",
          "-c",
          "${BIN}/tlslab pki -dir ${EVIDENCE}/pki >/dev/null && cat ${EVIDENCE}/pki/root.pem ${EVIDENCE}/pki/intermediate.pem > ${EVIDENCE}/pki/clientca.pem"
        ]
      ],
      "services": [
        {
          "name": "tcp22",
          "run": [
            "${BIN}/tcplab",
            "serve",
            "-addr",
            "198.18.181.10:22",
            "-mode",
            "discard",
            "-quiet"
          ],
          "port": 22
        },
        {
          "name": "tcp80",
          "run": [
            "${BIN}/tcplab",
            "serve",
            "-addr",
            "198.18.181.10:80",
            "-mode",
            "discard",
            "-quiet"
          ],
          "port": 80
        },
        {
          "name": "tcp443",
          "run": [
            "${BIN}/tcplab",
            "serve",
            "-addr",
            "198.18.181.10:443",
            "-mode",
            "discard",
            "-quiet"
          ],
          "port": 443
        },
        {
          "name": "tcp9090",
          "run": [
            "${BIN}/tcplab",
            "serve",
            "-addr",
            "198.18.181.10:9090",
            "-mode",
            "discard",
            "-quiet"
          ],
          "port": 9090
        },
        {
          "name": "tcp9091",
          "run": [
            "${BIN}/tcplab",
            "serve",
            "-addr",
            "198.18.181.10:9091",
            "-mode",
            "discard",
            "-quiet"
          ],
          "port": 9091
        },
        {
          "name": "tcp8080",
          "run": [
            "${BIN}/tcplab",
            "serve",
            "-addr",
            "198.18.181.10:8080",
            "-mode",
            "discard",
            "-quiet",
            "-backlog",
            "4"
          ],
          "port": 8080
        },
        {
          "name": "mtls",
          "run": [
            "${BIN}/tlslab",
            "serve",
            "-addr",
            "198.18.181.10:8443",
            "-default",
            "${EVIDENCE}/pki/shop-chain.pem,${EVIDENCE}/pki/shop.key",
            "-clientca",
            "${EVIDENCE}/pki/clientca.pem",
            "-authz",
            "orders-service=/orders"
          ],
          "port": 8443
        }
      ]
    },
    {
      "name": "db",
      "routes": [
        {
          "dst": "default",
          "via": "198.18.182.1"
        }
      ],
      "files": {
        "/etc/hosts": "127.0.0.1\tlocalhost\n198.18.181.10\tshop.test\n"
      },
      "services": [
        {
          "name": "tcp5432",
          "run": [
            "${BIN}/tcplab",
            "serve",
            "-addr",
            "198.18.182.10:5432",
            "-mode",
            "discard",
            "-quiet"
          ],
          "port": 5432
        }
      ]
    }
  ],
  "links": [
    {
      "a": {
        "node": "client",
        "if": "eth0",
        "addr": [
          "198.18.180.10/24"
        ]
      },
      "b": {
        "node": "fw",
        "if": "eth0",
        "addr": [
          "198.18.180.1/24"
        ]
      }
    },
    {
      "a": {
        "node": "server",
        "if": "eth0",
        "addr": [
          "198.18.181.10/24",
          "198.18.181.11/24",
          "198.18.181.12/24"
        ]
      },
      "b": {
        "node": "fw",
        "if": "eth1",
        "addr": [
          "198.18.181.1/24"
        ]
      }
    },
    {
      "a": {
        "node": "db",
        "if": "eth0",
        "addr": [
          "198.18.182.10/24"
        ]
      },
      "b": {
        "node": "fw",
        "if": "eth2",
        "addr": [
          "198.18.182.1/24"
        ]
      }
    }
  ],
  "requires": {
    "hping3": "apt-get install hping3",
    "nc": "apt-get install netcat-openbsd",
    "curl": "apt-get install curl",
    "conntrack": "apt-get install conntrack",
    "nft": "apt-get install nftables",
    "nstat": "apt-get install iproute2"
  },
  "checks": [
    {
      "type": "command",
      "node": "client",
      "name": "baseline: every port on the server accepts connections",
      "run": [
        "sh",
        "-c",
        "for p in 22 80 443 8080 9090 9091; do printf '%s ' $p; ${BIN}/tcplab dial -to 198.18.181.10:$p -timeout 2s  | cut -c1-40; done"
      ],
      "save": "baseline.txt",
      "expect_absent": [
        "gave up",
        "refused",
        "unreachable"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "a host firewall with one verdict per port (INPUT): ACCEPT 443; REJECT 80 with a TCP reset, 22 with the default ICMP port unreachable, 9090 icmp-host-prohibited, 9091 icmp-admin-prohibited; DROP 8080",
      "run": [
        "sh",
        "-c",
        "iptables -A INPUT -i lo -j ACCEPT && iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT && iptables -A INPUT -p tcp --dport 443 -j ACCEPT && iptables -A INPUT -p tcp --dport 80 -j REJECT --reject-with tcp-reset && iptables -A INPUT -p tcp --dport 22 -j REJECT && iptables -A INPUT -p tcp --dport 9090 -j REJECT --reject-with icmp-host-prohibited && iptables -A INPUT -p tcp --dport 9091 -j REJECT --reject-with icmp-admin-prohibited && iptables -P INPUT DROP"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "what the client sees for each: connected, refused (RST or port unreachable), unreachable (EHOSTUNREACH \u2014 'No route to host', though routing is fine), timeout (DROP)",
      "run": [
        "sh",
        "-c",
        "for p in 443 80 22 9090 9091 8080; do printf '%-5s ' $p; ${BIN}/tcplab dial -to 198.18.181.10:$p -timeout 2s  | cut -c1-48; done"
      ],
      "save": "verdicts.txt",
      "expect_contains": [
        "443   connect 1: connected",
        "80    connect 1: refused",
        "22    connect 1: refused",
        "9090  connect 1: unreachable",
        "9091  connect 1: unreachable",
        "8080  connect 1: gave up"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "the same through an ordinary tool: 'No route to host' from a REJECT is the classic misleading firewalld message",
      "run": [
        "sh",
        "-c",
        "nc -zv -w2 198.18.181.10 9090; nc -zv -w2 198.18.181.10 80; nc -zv -w2 198.18.181.10 8080; true"
      ],
      "save": "nc-messages.txt",
      "expect_contains": [
        "port 9090 (tcp) failed: No route to host",
        "port 80 (tcp) failed: Connection refused",
        "port 8080 (tcp) timed out"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "counters show which rule matched (the DROP policy's counter is in the chain header)",
      "run": [
        "iptables",
        "-vnL",
        "INPUT"
      ],
      "save": "counters.txt",
      "expect_contains": [
        "policy DROP",
        "reject-with tcp-reset",
        "reject-with icmp-host-prohibited"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "iptables here is iptables-nft: the same rules are an nftables table",
      "run": [
        "sh",
        "-c",
        "iptables -V; nft list chain ip filter INPUT"
      ],
      "save": "nft.txt",
      "expect_contains": [
        "(nf_tables)",
        "tcp dport 443 counter",
        "reject with icmp type host-prohibited"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "first match wins: a DROP inserted above the ACCEPT for 443 \u2026",
      "run": [
        "iptables",
        "-I",
        "INPUT",
        "1",
        "-p",
        "tcp",
        "--dport",
        "443",
        "-j",
        "DROP"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "\u2026 blocks 443 although the ACCEPT is still there",
      "run": [
        "sh",
        "-c",
        "${BIN}/tcplab dial -to 198.18.181.10:443 -timeout 2s "
      ],
      "expect_exit": 1,
      "expect_contains": [
        "gave up"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "delete it again",
      "run": [
        "iptables",
        "-D",
        "INPUT",
        "1"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "LOG the dropped 8080 traffic",
      "run": [
        "iptables",
        "-I",
        "INPUT",
        "3",
        "-p",
        "tcp",
        "--dport",
        "8080",
        "-j",
        "LOG",
        "--log-prefix",
        "COURSE-DROP "
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "a packet that matches the LOG rule \u2026",
      "run": [
        "sh",
        "-c",
        "b=$(dmesg | grep -c COURSE-DROP); ${BIN}/tcplab dial -to 198.18.181.10:8080 -timeout 1s  >/dev/null; sleep 0.2; echo \"new COURSE-DROP log lines: $(( $(dmesg | grep -c COURSE-DROP) - b ))\""
      ],
      "save": "log-off.txt",
      "expect_contains": [
        "new COURSE-DROP log lines: 0"
      ]
    },
    {
      "type": "command",
      "node": "@host",
      "name": "\u2026 is not logged: the kernel ignores LOG in every namespace but the host's unless net.netfilter.nf_log_all_netns=1 (this is why LOG rules in containers stay silent)",
      "run": [
        "sysctl",
        "-w",
        "net.netfilter.nf_log_all_netns=1"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "with it set, the drop is in the kernel log with the packet's addresses and ports",
      "run": [
        "sh",
        "-c",
        "b=$(dmesg | grep -c COURSE-DROP); ${BIN}/tcplab dial -to 198.18.181.10:8080 -timeout 1s  >/dev/null; sleep 0.2; echo \"new COURSE-DROP log lines: $(( $(dmesg | grep -c COURSE-DROP) - b ))\"; dmesg | grep COURSE-DROP | tail -1 | grep -o 'COURSE-DROP IN=eth0 .*SRC=198.18.180.10 DST=198.18.181.10.*DPT=8080'"
      ],
      "save": "log-on.txt",
      "expect_contains": [
        "COURSE-DROP IN=eth0",
        "DPT=8080"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "reset the host firewall",
      "run": [
        "sh",
        "-c",
        "iptables -P INPUT ACCEPT && iptables -F INPUT"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "stateful, 1: a client whose INPUT drops everything but loopback \u2026",
      "run": [
        "sh",
        "-c",
        "iptables -A INPUT -i lo -j ACCEPT && iptables -P INPUT DROP"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "\u2026 cannot complete its own outgoing connections: the SYN-ACK is just another inbound packet",
      "run": [
        "sh",
        "-c",
        "${BIN}/tcplab dial -to 198.18.181.10:443 -timeout 2s "
      ],
      "expect_exit": 1,
      "expect_contains": [
        "gave up"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "allow traffic that belongs to connections conntrack already knows",
      "run": [
        "iptables",
        "-I",
        "INPUT",
        "1",
        "-m",
        "conntrack",
        "--ctstate",
        "ESTABLISHED,RELATED",
        "-j",
        "ACCEPT"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "now outgoing connections work and nothing else gets in",
      "run": [
        "sh",
        "-c",
        "${BIN}/tcplab dial -to 198.18.181.10:443 -timeout 2s ; conntrack -L -p tcp --dport 443 2>/dev/null | head -1"
      ],
      "save": "stateful.txt",
      "expect_contains": [
        "connected",
        "dport=443"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "undo",
      "run": [
        "sh",
        "-c",
        "iptables -P INPUT ACCEPT && iptables -F INPUT"
      ]
    },
    {
      "type": "command",
      "node": "fw",
      "name": "stateless, as an AWS network ACL: allow 443 inbound \u2014 and, mirroring it, 'dport 443' outbound",
      "run": [
        "sh",
        "-c",
        "iptables -P FORWARD DROP && iptables -A FORWARD -i eth0 -o eth1 -p tcp --dport 443 -j ACCEPT && iptables -A FORWARD -i eth1 -o eth0 -p tcp --dport 443 -j ACCEPT"
      ]
    },
    {
      "type": "capture",
      "node": "fw",
      "if": "eth1",
      "filter": "tcp port 443",
      "decode": [
        "-nn"
      ],
      "save": "nacl.pcap",
      "name": "the SYN reaches the server and the SYN-ACK leaves it \u2014 and dies at the ACL, which has no rule for traffic FROM port 443 to the client's ephemeral port",
      "during": {
        "node": "client",
        "run": [
          "sh",
          "-c",
          "${BIN}/tcplab dial -to 198.18.181.10:443 -timeout 2s "
        ]
      },
      "expect_contains": [
        "198.18.180.10.",
        "> 198.18.181.10.443: Flags [S]",
        "198.18.181.10.443 > 198.18.180.10.",
        "Flags [S.]",
        "gave up"
      ]
    },
    {
      "type": "command",
      "node": "fw",
      "name": "the return rule a stateless ACL needs: from port 443 to the client ephemeral range",
      "run": [
        "iptables",
        "-R",
        "FORWARD",
        "2",
        "-i",
        "eth1",
        "-o",
        "eth0",
        "-p",
        "tcp",
        "--sport",
        "443",
        "--dport",
        "1024:65535",
        "-j",
        "ACCEPT"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "works (Linux clients use 32768\u201360999; NAT gateways and other OSes use more of 1024\u201365535)",
      "run": [
        "sh",
        "-c",
        "${BIN}/tcplab dial -to 198.18.181.10:443 -timeout 2s ; sysctl net.ipv4.ip_local_port_range"
      ],
      "save": "nacl-fixed.txt",
      "expect_contains": [
        "connected",
        "32768"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "but a stateless return rule is a hole: anything FROM port 443 may enter \u2014 here a new connection from the server side to the client's port 5000",
      "run": [
        "sh",
        "-c",
        "nc -zv -w2 -s 198.18.181.11 -p 443 198.18.180.10 5000"
      ],
      "save": "nacl-hole.txt",
      "expect_contains": [
        "succeeded"
      ]
    },
    {
      "type": "command",
      "node": "fw",
      "name": "stateful instead: allow NEW connections to 443 one way, and only established traffic back",
      "run": [
        "sh",
        "-c",
        "iptables -F FORWARD && iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT && iptables -A FORWARD -i eth0 -o eth1 -p tcp --dport 443 -m conntrack --ctstate NEW -j ACCEPT"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "the client still connects",
      "run": [
        "sh",
        "-c",
        "${BIN}/tcplab dial -to 198.18.181.10:443 -timeout 2s "
      ],
      "expect_contains": [
        "connected"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "and the hole is closed (a different source address, so no leftover TIME_WAIT is involved)",
      "run": [
        "sh",
        "-c",
        "nc -zv -w2 -s 198.18.181.12 -p 443 198.18.180.10 5000"
      ],
      "save": "stateful-hole.txt",
      "expect_exit": 1,
      "expect_contains": [
        "timed out"
      ]
    },
    {
      "type": "command",
      "node": "fw",
      "name": "allow the client to the mTLS service port",
      "run": [
        "iptables",
        "-A",
        "FORWARD",
        "-i",
        "eth0",
        "-o",
        "eth1",
        "-p",
        "tcp",
        "--dport",
        "8443",
        "-m",
        "conntrack",
        "--ctstate",
        "NEW",
        "-j",
        "ACCEPT"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "identity, not location: an mTLS service authorizes by certificate identity \u2014 orders-service may read /orders",
      "run": [
        "sh",
        "-c",
        "curl -sS -m 3 --noproxy '*' --cacert ${EVIDENCE}/pki/root.pem -w ' [HTTP %{http_code}]\\n' --cert ${EVIDENCE}/pki/client.pem --key ${EVIDENCE}/pki/client.key https://shop.test:8443/orders/42"
      ],
      "save": "authz-allowed.txt",
      "expect_contains": [
        "client orders-service",
        "[HTTP 200]"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "the same verified identity is refused another path: authentication is not authorization",
      "run": [
        "sh",
        "-c",
        "curl -sS -m 3 --noproxy '*' --cacert ${EVIDENCE}/pki/root.pem -w ' [HTTP %{http_code}]\\n' --cert ${EVIDENCE}/pki/client.pem --key ${EVIDENCE}/pki/client.key https://shop.test:8443/admin"
      ],
      "save": "authz-forbidden.txt",
      "expect_contains": [
        "403 forbidden",
        "[HTTP 403]"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "no certificate: the TLS handshake itself fails (TLS 1.3 alert certificate required)",
      "run": [
        "sh",
        "-c",
        "curl -sS -m 3 --noproxy '*' --cacert ${EVIDENCE}/pki/root.pem -w ' [HTTP %{http_code}]\\n' https://shop.test:8443/orders/42; true"
      ],
      "save": "authz-nocert.txt",
      "expect_contains": [
        "alert certificate required"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "a certificate from another CA: rejected (unknown CA), whatever its name says",
      "run": [
        "sh",
        "-c",
        "curl -sS -m 3 --noproxy '*' --cacert ${EVIDENCE}/pki/root.pem -w ' [HTTP %{http_code}]\\n' --cert ${EVIDENCE}/pki/rogue-client.pem --key ${EVIDENCE}/pki/rogue-client.key https://shop.test:8443/orders/42; true"
      ],
      "save": "authz-rogue.txt",
      "expect_contains": [
        "alert unknown ca"
      ]
    },
    {
      "type": "command",
      "node": "fw",
      "name": "let the database host reach the service too",
      "run": [
        "iptables",
        "-A",
        "FORWARD",
        "-i",
        "eth2",
        "-o",
        "eth1",
        "-p",
        "tcp",
        "--dport",
        "8443",
        "-m",
        "conntrack",
        "--ctstate",
        "NEW",
        "-j",
        "ACCEPT"
      ]
    },
    {
      "type": "command",
      "node": "db",
      "name": "from a different network, the same identity gets the same answer \u2014 the network location never entered the decision",
      "run": [
        "sh",
        "-c",
        "curl -sS -m 3 --noproxy '*' --cacert ${EVIDENCE}/pki/root.pem -w ' [HTTP %{http_code}]\\n' --cert ${EVIDENCE}/pki/client.pem --key ${EVIDENCE}/pki/client.key https://shop.test:8443/orders/7"
      ],
      "save": "authz-db.txt",
      "expect_contains": [
        "[HTTP 200]"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "the service's decisions, with source addresses",
      "run": [
        "sh",
        "-c",
        "grep -E 'authz|handshake error' ${EVIDENCE}/service-server-mtls.log | cut -d' ' -f2-"
      ],
      "save": "authz-log.txt",
      "expect_contains": [
        "authz: /admin from 198.18.180.10",
        "denied",
        "client didn't provide a certificate",
        "unknown authority",
        "from 198.18.182.10"
      ]
    },
    {
      "type": "command",
      "node": "fw",
      "name": "tiers: the web tier may reach the database on 5432; nothing else crosses",
      "run": [
        "iptables",
        "-A",
        "FORWARD",
        "-i",
        "eth1",
        "-o",
        "eth2",
        "-p",
        "tcp",
        "--dport",
        "5432",
        "-m",
        "conntrack",
        "--ctstate",
        "NEW",
        "-j",
        "ACCEPT"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "web \u2192 db: allowed",
      "run": [
        "sh",
        "-c",
        "${BIN}/tcplab dial -to 198.18.182.10:5432 -timeout 2s "
      ],
      "expect_contains": [
        "connected"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "client \u2192 db: dropped at the firewall (a timeout, not a refusal \u2014 the client cannot tell 'blocked' from 'down')",
      "run": [
        "sh",
        "-c",
        "${BIN}/tcplab dial -to 198.18.182.10:5432 -timeout 2s "
      ],
      "save": "tier-client-db.txt",
      "expect_exit": 1,
      "expect_contains": [
        "gave up"
      ]
    },
    {
      "type": "command",
      "node": "db",
      "name": "db \u2192 web (a compromised database calling out): dropped",
      "run": [
        "sh",
        "-c",
        "${BIN}/tcplab dial -to 198.18.181.10:22 -timeout 2s "
      ],
      "expect_exit": 1,
      "expect_contains": [
        "gave up"
      ]
    },
    {
      "type": "command",
      "node": "fw",
      "name": "the FORWARD counters show each decision",
      "run": [
        "iptables",
        "-vnL",
        "FORWARD"
      ],
      "save": "tiers.txt",
      "expect_contains": [
        "policy DROP",
        "dpt:5432",
        "dpt:443"
      ]
    },
    {
      "type": "command",
      "node": "fw",
      "name": "open forwarding again for the next experiments",
      "run": [
        "sh",
        "-c",
        "iptables -P FORWARD ACCEPT && iptables -F FORWARD"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "SYN flood setup: the client drops its own RSTs (so the server's SYN-ACKs to hping3's raw SYNs are never answered) \u2014 the listener on 8080 has a backlog of 4",
      "run": [
        "iptables",
        "-A",
        "OUTPUT",
        "-p",
        "tcp",
        "--tcp-flags",
        "RST",
        "RST",
        "-j",
        "DROP"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "SYN cookies off",
      "run": [
        "sh",
        "-c",
        "sysctl -w net.ipv4.tcp_syncookies=0 && nstat -n"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "200 SYNs in 0.4 s, then a real connection: it cannot get into the full SYN queue",
      "run": [
        "sh",
        "-c",
        "hping3 -q -S -p 8080 -c 200 -i u2000 198.18.181.10 >/dev/null 2>&1; ${BIN}/tcplab dial -to 198.18.181.10:8080 -timeout 5s "
      ],
      "save": "syn-nocookies.txt",
      "expect_exit": 1,
      "expect_contains": [
        "gave up"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "half-open connections and the counters: every SYN past the queue was dropped",
      "run": [
        "sh",
        "-c",
        "echo \"SYN-RECV: $(ss -Htn state syn-recv sport = :8080 | wc -l)\"; nstat | grep -E 'ListenDrops|ReqQFull'"
      ],
      "save": "syn-nocookies-counters.txt",
      "expect_contains": [
        "TcpExtTCPReqQFullDrop"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "SYN cookies on (Linux's default, 1 = when the queue overflows) \u2014 the queue is still full of the flood's half-open entries",
      "run": [
        "sh",
        "-c",
        "sysctl -w net.ipv4.tcp_syncookies=1 && nstat -n"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "another flood, and the real connection now succeeds: its SYN-ACK carries a cookie instead of a queue entry",
      "run": [
        "sh",
        "-c",
        "hping3 -q -S -p 8080 -c 200 -i u2000 198.18.181.10 >/dev/null 2>&1; ${BIN}/tcplab dial -to 198.18.181.10:8080 -timeout 5s "
      ],
      "save": "syn-cookies.txt",
      "expect_contains": [
        "connected"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "the counters: cookies sent for the overflow (and the kernel warned 'Possible SYN flooding \u2026 Sending cookies')",
      "run": [
        "sh",
        "-c",
        "nstat | grep -E 'Syncookies|ReqQFull'"
      ],
      "save": "syn-cookies-counters.txt",
      "expect_contains": [
        "TcpExtSyncookiesSent",
        "TcpExtTCPReqQFullDoCookies"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "stop dropping RSTs",
      "run": [
        "iptables",
        "-D",
        "OUTPUT",
        "-p",
        "tcp",
        "--tcp-flags",
        "RST",
        "RST",
        "-j",
        "DROP"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "rate-limit new SSH connections: at most 3 per source per 10 s (the recent match)",
      "run": [
        "sh",
        "-c",
        "iptables -A INPUT -p tcp --dport 22 -m conntrack --ctstate NEW -m recent --name ssh --set && iptables -A INPUT -p tcp --dport 22 -m conntrack --ctstate NEW -m recent --name ssh --rcheck --seconds 10 --hitcount 4 -j DROP"
      ]
    },
    {
      "type": "command",
      "node": "client",
      "name": "six connections in a row: three get in, the rest are dropped",
      "run": [
        "sh",
        "-c",
        "for i in 1 2 3 4 5 6; do ${BIN}/tcplab dial -to 198.18.181.10:22 -timeout 1s  | cut -c11-40; done"
      ],
      "save": "ratelimit.txt",
      "expect_contains": [
        "connected",
        "gave up"
      ]
    },
    {
      "type": "command",
      "node": "server",
      "name": "the source's record",
      "run": [
        "sh",
        "-c",
        "cat /proc/net/xt_recent/ssh | cut -c1-40"
      ],
      "expect_contains": [
        "src=198.18.180.10"
      ]
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "sysctl -n net.netfilter.nf_log_all_netns > /run/netlab-firewall-nf_log_all_netns"
    ]
  ],
  "teardown": [
    [
      "sh",
      "-c",
      "[ -f /run/netlab-firewall-nf_log_all_netns ] && sysctl -qw net.netfilter.nf_log_all_netns=$(cat /run/netlab-firewall-nf_log_all_netns) && rm -f /run/netlab-firewall-nf_log_all_netns"
    ]
  ]
}